# Copy this file to ops/.env and replace every placeholder before starting the stack.
# URL-encode special characters in the password used inside EASYTOWING_DATABASE_URL.
EASYTOWING_DB_PASSWORD=replace-with-a-long-random-password
EASYTOWING_DATABASE_URL=postgresql://easytowing:replace-with-a-long-random-password@db:5432/easytowing
EASYTOWING_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
EASYTOWING_WORKER_ID=easytowing-worker-01
EASYTOWING_HTTP_PORT=8000

# Use either the local directory or the S3-compatible bucket, never both.
# For production, prefer an IAM/workload identity and KMS-backed encryption.
EASYTOWING_ARTIFACT_STORAGE_DIR=/var/lib/easytowing/artifacts
EASYTOWING_ARTIFACT_S3_BUCKET=
EASYTOWING_ARTIFACT_S3_PREFIX=easytowing
EASYTOWING_ARTIFACT_S3_REGION=
EASYTOWING_ARTIFACT_S3_ENDPOINT_URL=
EASYTOWING_ARTIFACT_S3_SSE=AES256
EASYTOWING_ARTIFACT_S3_KMS_KEY_ID=

# Leave empty until Monroc has approved the exact criteria for a named case.
EASYTOWING_MONROC_ACCEPTANCE_PROFILES_JSON=
